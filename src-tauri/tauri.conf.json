{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poser",
  "version": "3.0.0",
  "identifier": "design.ivg.poser",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Poser",
        "width": 360,
        "height": 780,
        "minWidth": 320,
        "minHeight": 520,
        "alwaysOnTop": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
